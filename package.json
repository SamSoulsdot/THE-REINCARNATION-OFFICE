{
  "name": "the-reincarnation-office",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "THE REINCARNATION OFFICE — avventura investigativa narrativa nella burocrazia dell'aldilà",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "content:stats": "vitest run tests/unit/contentStats.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "dexie": "^4.4.7",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
